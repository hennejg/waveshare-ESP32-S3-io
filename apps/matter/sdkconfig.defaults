# Target: ESP32-S3 — Matter-only firmware
# Waveshare ESP32-S3-POE-ETH-8DI-8DO: 16MB flash, 8MB OCTAL PSRAM

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_RX_BA_WIN=6

CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# BLE for Matter commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_CTRL_BLE_MAX_ACT=6
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=6
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=20

CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_CHIP_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=5120
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_ENABLE_ETHERNET_TELEMETRY=y
CONFIG_ETHERNET_NETWORK_COMMISSIONING_DRIVER=y
CONFIG_ETHERNET_NETWORK_ENDPOINT_ID=0

CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

CONFIG_ESP_WIFI_NVS_ENABLED=n

# Board driver options — no MQTT/scripting in matter app
CONFIG_APP_MQTT_ENABLE=n
CONFIG_APP_SCRIPTING_ENABLE=n
CONFIG_APP_MATTER_ENABLE=y

# Modbus: RTU slave on RS-485 and the Modbus TCP server, nothing else -- no
# RS-485 master, no gateway, no TCP master. Started only once the device is
# commissioned (main.c): before that the setup AP and BLE leave too little
# internal RAM. Four TCP clients at a time, a short backlog.
CONFIG_MB_RS485_MASTER=n
CONFIG_MB_TCP_MAX_CONN=4
CONFIG_MB_TCP_BACKLOG=4
# The UART driver's ring buffer functions sit in IRAM by default, 2.9 KB of
# the internal RAM this firmware runs short of. Only the non-ISR ones move;
# the UART ISR is not in IRAM here (CONFIG_UART_ISR_IN_IRAM is off).
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# Sockets: the web server (7 clients + 3), the setup portal (3) and Modbus
# TCP (listen + 4 + 1 refused) -- apps/matter/main/net_budget.h adds them up
# and checks the sum at compile time.
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_MAX_ACTIVE_TCP=28
