# Target: ESP32-S3 (set via: idf.py set-target esp32s3)
# Waveshare ESP32-S3-POE-ETH-8DI-8DO: 16MB flash, 8MB OCTAL PSRAM

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Enable PSRAM (8MB OPI/OCTAL on this board)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Partition table: use custom to fit 16MB flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Ethernet — enable built-in SPI Ethernet and W5500 driver
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Disable mbedTLS hardware acceleration to avoid GDMA conflicts with I2C.
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n

# TCP send/receive buffers
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192

# PSRAM heap routing
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Board driver options
CONFIG_APP_MQTT_ENABLE=y
CONFIG_APP_SNTP_ENABLE=y
CONFIG_APP_SCRIPTING_ENABLE=y

# No Matter in the full firmware
CONFIG_APP_MATTER_ENABLE=n

# Sockets. The default of ten is shared by the web server, MQTT and SNTP;
# Modbus TCP serving several clients at once needs its own share on top.
CONFIG_LWIP_MAX_SOCKETS=24

# cJSON parses by recursion and guards only the nesting depth, not the stack.
# At the default of 1000 a body of nothing but '[' overflows the HTTP task's
# stack -- and /api/auth/set-password parses before it checks the token, so
# that is reachable without credentials. The deepest JSON this firmware reads
# is three levels (object, array, object).
CONFIG_CJSON_NESTING_LIMIT=16

# The Modbus master's response timeout is a setting, up to 10 s. The stack
# silently replaces any value at or above this threshold with its own default,
# so the threshold has to be above the range the configuration offers.
CONFIG_FMB_MASTER_MAX_API_BLOCKING_TIME_MS=12000
